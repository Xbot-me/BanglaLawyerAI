# Bangladesh Legal Platform — Environment Configuration

# 1. Groq Cloud Llama 3.1 70B API Key (Get a free key in 10 seconds at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. LLM Provider Choice: "llama_groq", "llama_ollama", or "ground_truth"
LLM_PROVIDER=llama_groq

# 3. PostgreSQL Database Connection
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=lawyer_db
POSTGRES_USER=lawyer_user
POSTGRES_PASSWORD=lawyer_pass
